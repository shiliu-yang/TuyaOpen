CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_ENABLE_CHAT_DISPLAY=y
CONFIG_ENABLE_GUI_STREAM_AI_TEXT=y
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_WAVESHARE_T5AI_TOUCH_AMOLED_1_75=y
CONFIG_ENABLE_LIBLVGL=y
CONFIG_LVGL_ENABLE_TOUCH=y
CONFIG_UART_PRINT_BAUD_RATE=115200



# GPS Interface Configuration
CONFIG_USE_GPS_UART=y
CONFIG_EXAMPLE_UART_PORT=2
CONFIG_EXAMPLE_UART_TX_PIN=41
CONFIG_EXAMPLE_UART_RX_PIN=40
CONFIG_EXAMPLE_UART_BAUDRATE=9600

